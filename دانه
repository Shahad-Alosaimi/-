/* ============================================
   تطمن — جامعة الطائف
   ملف التصميم الكامل
   الخط: Aref Ruqaa Ink + Cairo
   ============================================ */

@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;900&family=Aref+Ruqaa+Ink:wght@400;700&display=swap');

/* ===== المتغيرات ===== */
:root {
  --gold:        #c49e50;
  --gold-dim:    rgba(196,158,80,0.18);
  --gold-glow:   rgba(196,158,80,0.06);
  --bg-main:     #0e1520;
  --bg-dark:     #080f18;
  --bg-card:     rgba(255,255,255,0.025);
  --text-main:   #e6ddd0;
  --text-muted:  rgba(230,221,208,0.42);
  --text-faint:  rgba(230,221,208,0.22);
  --border:      rgba(196,158,80,0.14);
  --border-soft: rgba(196,158,80,0.08);
  --red-dot:     #c06050;
  --green-dot:   #50966e;
  --radius:      3px;
}

/* ===== ريسيت ===== */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

body {
  font-family: 'Cairo', sans-serif;
  font-weight: 400;
  background: var(--bg-main);
  color: var(--text-main);
  direction: rtl;
  min-height: 100vh;
}

a { text-decoration: none; color: inherit; transition: color 0.2s; }
img { max-width: 100%; display: block; }
ul { list-style: none; }

/* ===== NAVBAR ===== */
.navbar {
  background: var(--bg-dark);
  height: 66px;
  padding: 0 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
  gap: 24px;
}

.logo {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
  text-decoration: none;
}

.logo-main {
  font-family: 'Aref Ruqaa Ink', serif;
  font-size: 26px;
  font-weight: 700;
  color: var(--gold);
  letter-spacing: 0.02em;
}

.logo-sub {
  font-size: 9px;
  font-weight: 300;
  color: rgba(196,158,80,0.42);
  letter-spacing: 0.22em;
  margin-top: 1px;
}

.nav-links {
  display: flex;
  gap: 28px;
  flex: 1;
  justify-content: center;
}

.nav-links a {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-muted);
}
.nav-links a:hover,
.nav-links a.active { color: var(--gold); }

.nav-actions { display: flex; gap: 10px; align-items: center; }

.btn-login {
  font-family: 'Cairo', sans-serif;
  font-size: 12px;
  font-weight: 600;
  padding: 9px 22px;
  border: 1px solid rgba(196,158,80,0.35);
  color: var(--gold);
  background: transparent;
  cursor: pointer;
  border-radius: var(--radius);
  transition: background 0.2s;
}
.btn-login:hover { background: rgba(196,158,80,0.09); }

.btn-register {
  font-family: 'Cairo', sans-serif;
  font-size: 12px;
  font-weight: 700;
  padding: 9px 22px;
  border: none;
  background: var(--gold);
  color: var(--bg-dark);
  cursor: pointer;
  border-radius: var(--radius);
  transition: opacity 0.2s;
}
.btn-register:hover { opacity: 0.85; }

/* ===== HERO ===== */
.hero {
  background: var(--bg-dark);
  padding: 72px 40px 60px;
  text-align: center;
  border-bottom: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: -100px; left: 50%; transform: translateX(-50%);
  width: 700px; height: 360px;
  background: radial-gradient(ellipse, var(--gold-glow) 0%, transparent 68%);
  pointer-events: none;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 500;
  color: var(--gold);
  background: rgba(196,158,80,0.08);
  border: 1px solid rgba(196,158,80,0.22);
  padding: 5px 18px;
  border-radius: 20px;
  margin-bottom: 30px;
  letter-spacing: 0.08em;
}

.hero-badge::before {
  content: '';
  width: 6px; height: 6px;
  background: var(--gold);
  border-radius: 50%;
}

.hero-title {
  font-family: 'Aref Ruqaa Ink', serif;
  font-size: 58px;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
  margin-bottom: 8px;
  letter-spacing: 0.02em;
  position: relative;
  z-index: 1;
}

.hero-title .gold { color: var(--gold); }

.hero-title .sub {
  display: block;
  font-size: 34px;
  font-weight: 400;
  color: var(--text-muted);
  margin-top: 4px;
}

.hero-desc {
  font-size: 13px;
  font-weight: 300;
  color: var(--text-muted);
  letter-spacing: 0.06em;
  line-height: 2;
  margin-bottom: 38px;
}

.hero-btns {
  display: flex;
  gap: 14px;
  justify-content: center;
  margin-bottom: 52px;
  flex-wrap: wrap;
}

.btn-lost {
  font-family: 'Cairo', sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.04em;
  padding: 13px 36px;
  background: var(--gold);
  color: var(--bg-dark);
  border: none;
  cursor: pointer;
  border-radius: var(--radius);
  transition: opacity 0.2s;
}
.btn-lost:hover { opacity: 0.85; }

.btn-found {
  font-family: 'Cairo', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 13px 36px;
  background: transparent;
  color: var(--text-main);
  border: 1px solid rgba(230,221,208,0.25);
  cursor: pointer;
  border-radius: var(--radius);
  transition: all 0.2s;
}
.btn-found:hover { border-color: var(--gold); color: var(--gold); }

/* ===== إحصائيات الهيرو ===== */
.hero-stats {
  display: flex;
  justify-content: center;
  gap: 0;
  border-top: 1px solid var(--border-soft);
  padding-top: 36px;
}

.stat {
  padding: 0 44px;
  border-left: 1px solid var(--border-soft);
  text-align: center;
}
.stat:last-child { border-left: none; }

.stat-num {
  font-family: 'Aref Ruqaa Ink', serif;
  font-size: 42px;
  font-weight: 700;
  color: var(--gold);
  display: block;
  line-height: 1;
  margin-bottom: 8px;
}

.stat-lbl {
  font-size: 11px;
  font-weight: 300;
  color: var(--text-muted);
  letter-spacing: 0.1em;
}

/* ===== شريط البحث ===== */
.search-bar {
  background: var(--bg-dark);
  padding: 20px 40px;
  display: flex;
  gap: 0;
  border-bottom: 1px solid var(--border);
}

.search-bar input,
.search-bar select {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-left: none;
  color: var(--text-main);
  padding: 12px 18px;
  font-family: 'Cairo', sans-serif;
  font-size: 12px;
  font-weight: 400;
  outline: none;
  transition: border-color 0.2s;
}

.search-bar input:first-child {
  flex: 1;
  border-right: 1px solid var(--border);
}

.search-bar input::placeholder { color: var(--text-muted); }
.search-bar input:focus,
.search-bar select:focus { border-color: rgba(196,158,80,0.45); }
.search-bar select option { background: var(--bg-dark); }

.search-btn {
  font-family: 'Cairo', sans-serif;
  font-size: 13px;
  font-weight: 700;
  padding: 12px 32px;
  background: var(--gold);
  color: var(--bg-dark);
  border: none;
  cursor: pointer;
  transition: opacity 0.2s;
}
.search-btn:hover { opacity: 0.85; }

/* ===== الحاوية الرئيسية ===== */
.main-content {
  min-height: calc(100vh - 200px);
  padding: 36px 40px;
}

/* ===== رأس القسم ===== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.section-title {
  font-family: 'Aref Ruqaa Ink', serif;
  font-size: 26px;
  font-weight: 700;
  color: var(--text-main);
}

.section-title span { color: var(--gold); }

.section-divider {
  flex: 1;
  height: 1px;
  background: var(--border-soft);
  margin: 0 18px;
}

.section-link {
  font-size: 12px;
  font-weight: 500;
  color: var(--gold);
  display: flex;
  align-items: center;
  gap: 5px;
}
.section-link:hover { opacity: 0.75; }

/* ===== شريط البلاغات الأفقي ===== */
.items-strip {
  border: 1px solid var(--border);
  border-radius: 4px;
  overflow: hidden;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 18px 24px;
  border-bottom: 1px solid var(--border-soft);
  cursor: pointer;
  transition: background 0.2s;
  gap: 16px;
  text-decoration: none;
  color: inherit;
}
.item-row:last-child { border-bottom: none; }
.item-row:hover { background: rgba(196,158,80,0.04); }

.row-badge {
  display: flex;
  align-items: center;
  gap: 7px;
  min-width: 76px;
  flex-shrink: 0;
}

.type-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
}
.dot-lost  { background: var(--red-dot); }
.dot-found { background: var(--green-dot); }

.type-label { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; }
.label-lost  { color: var(--red-dot); }
.label-found { color: var(--green-dot); }

.row-icon {
  width: 44px; height: 44px;
  background: rgba(196,158,80,0.07);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: var(--radius);
}
.row-icon i { font-size: 19px; color: rgba(196,158,80,0.55); }
.row-icon img { width:100%; height:100%; object-fit:cover; border-radius: var(--radius); }

.row-main { flex: 1; min-width: 0; }

.row-title {
  font-family: 'Aref Ruqaa Ink', serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.row-desc {
  font-size: 11px;
  font-weight: 300;
  color: var(--text-muted);
  line-height: 1.5;
}

.row-meta {
  flex-shrink: 0;
  text-align: left;
  margin-right: 16px;
}

.meta-item {
  font-size: 11px;
  font-weight: 300;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 5px;
  justify-content: flex-end;
  line-height: 1.9;
}
.meta-item i { font-size: 12px; }

.row-arrow { color: rgba(196,158,80,0.28); font-size: 13px; flex-shrink: 0; }

/* ===== حالة البلاغ ===== */
.status-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 600;
  padding: 3px 12px;
  border-radius: 20px;
  letter-spacing: 0.06em;
}
.status-active   { background:rgba(192,96,80,0.12);  color:var(--red-dot);   border:1px solid rgba(192,96,80,0.2); }
.status-found    { background:rgba(80,150,110,0.12); color:var(--green-dot); border:1px solid rgba(80,150,110,0.2); }
.status-resolved { background:rgba(196,158,80,0.1);  color:var(--gold);      border:1px solid rgba(196,158,80,0.2); }

/* ===== الفورم (إضافة بلاغ / تسجيل / دخول) ===== */
.form-container {
  background: var(--bg-dark);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 36px 40px;
  max-width: 580px;
  margin: 0 auto;
}

.form-title {
  font-family: 'Aref Ruqaa Ink', serif;
  font-size: 28px;
  font-weight: 700;
  color: var(--gold);
  text-align: center;
  margin-bottom: 28px;
  letter-spacing: 0.02em;
}

.form-group { margin-bottom: 18px; }

.form-group label {
  display: block;
  font-size: 12px;
  font-weight: 500;
  color: var(--text-muted);
  margin-bottom: 7px;
  letter-spacing: 0.08em;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  background: var(--bg-card);
  border: 1px solid var(--border);
  color: var(--text-main);
  padding: 11px 16px;
  font-family: 'Cairo', sans-serif;
  font-size: 13px;
  border-radius: var(--radius);
  outline: none;
  transition: border-color 0.2s;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus { border-color: rgba(196,158,80,0.5); }

.form-group input::placeholder { color: var(--text-faint); }
.form-group textarea { resize: vertical; min-height: 100px; }
.form-group select option { background: var(--bg-dark); }

.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

.btn-submit {
  width: 100%;
  font-family: 'Cairo', sans-serif;
  font-size: 14px;
  font-weight: 700;
  padding: 13px;
  background: var(--gold);
  color: var(--bg-dark);
  border: none;
  border-radius: var(--radius);
  cursor: pointer;
  transition: opacity 0.2s;
  letter-spacing: 0.04em;
  margin-top: 6px;
}
.btn-submit:hover { opacity: 0.85; }

.form-link {
  text-align: center;
  margin-top: 16px;
  font-size: 13px;
  color: var(--text-muted);
}
.form-link a { color: var(--gold); }

/* ===== التنبيهات ===== */
.alert {
  padding: 12px 16px;
  border-radius: var(--radius);
  margin-bottom: 20px;
  font-size: 13px;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8px;
}
.alert-error   { background:rgba(192,96,80,0.1);  color:#e08070; border:1px solid rgba(192,96,80,0.25); }
.alert-success { background:rgba(80,150,110,0.1); color:#70c090; border:1px solid rgba(80,150,110,0.25); }

/* ===== صفحة التفاصيل ===== */
.item-detail {
  background: var(--bg-dark);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 32px;
  max-width: 860px;
  margin: 0 auto;
}

.detail-type {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
}

.detail-title {
  font-family: 'Aref Ruqaa Ink', serif;
  font-size: 32px;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 24px;
  line-height: 1.2;
}

.detail-images {
  display: flex;
  gap: 12px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}

.detail-images img {
  width: 200px;
  height: 160px;
  object-fit: cover;
  border-radius: var(--radius);
  border: 1px solid var(--border);
}

.detail-table { width: 100%; border-collapse: collapse; }
.detail-table td {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-soft);
  font-size: 13px;
  vertical-align: top;
}
.detail-table td:first-child {
  color: var(--text-muted);
  width: 130px;
  font-weight: 500;
  white-space: nowrap;
}

.btn-contact {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'Cairo', sans-serif;
  font-size: 13px;
  font-weight: 700;
  padding: 13px 30px;
  background: var(--gold);
  color: var(--bg-dark);
  border: none;
  border-radius: var(--radius);
  cursor: pointer;
  margin-top: 24px;
  transition: opacity 0.2s;
  text-decoration: none;
}
.btn-contact:hover { opacity: 0.85; }

/* ===== لوحة التحكم ===== */
.dashboard-grid {
  display: grid;
  grid-template-columns: 230px 1fr;
  gap: 24px;
}

.sidebar {
  background: var(--bg-dark);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 24px 16px;
  height: fit-content;
  position: sticky;
  top: 90px;
}

.sidebar-avatar {
  width: 64px; height: 64px;
  background: rgba(196,158,80,0.1);
  border: 1px solid var(--border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  color: var(--gold);
  margin: 0 auto 14px;
}

.sidebar-name {
  text-align: center;
  font-size: 15px;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 4px;
}

.sidebar-email {
  text-align: center;
  font-size: 11px;
  color: var(--text-muted);
  margin-bottom: 20px;
}

.sidebar-divider {
  height: 1px;
  background: var(--border-soft);
  margin-bottom: 16px;
}

.sidebar a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-radius: var(--radius);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-muted);
  transition: all 0.2s;
  margin-bottom: 2px;
}
.sidebar a:hover,
.sidebar a.active {
  background: rgba(196,158,80,0.07);
  color: var(--gold);
}
.sidebar a i { font-size: 16px; }
.sidebar-logout { color: var(--red-dot) !important; }

/* ===== بطاقات الإحصائيات ===== */
.stat-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 24px;
}

.stat-card {
  background: var(--bg-dark);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 20px 22px;
  text-align: center;
}

.stat-card-num {
  font-family: 'Aref Ruqaa Ink', serif;
  font-size: 38px;
  font-weight: 700;
  color: var(--gold);
  display: block;
  line-height: 1;
  margin-bottom: 8px;
}

.stat-card-lbl {
  font-size: 11px;
  font-weight: 300;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}

/* ===== جدول لوحة التحكم ===== */
.dashboard-table {
  background: var(--bg-dark);
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  width: 100%;
  border-collapse: collapse;
}

.dashboard-table thead {
  background: rgba(196,158,80,0.05);
  border-bottom: 1px solid var(--border);
}

.dashboard-table th {
  padding: 12px 18px;
  text-align: right;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.1em;
  white-space: nowrap;
}

.dashboard-table td {
  padding: 14px 18px;
  border-bottom: 1px solid var(--border-soft);
  font-size: 13px;
  color: var(--text-main);
  vertical-align: middle;
}

.dashboard-table tr:last-child td { border-bottom: none; }
.dashboard-table tr:hover td { background: rgba(196,158,80,0.02); }

.tbl-action {
  font-size: 12px;
  font-weight: 600;
  padding: 5px 14px;
  border-radius: 20px;
  cursor: pointer;
  font-family: 'Cairo', sans-serif;
  border: none;
  transition: opacity 0.2s;
}
.tbl-action:hover { opacity: 0.75; }
.act-edit     { background:rgba(196,158,80,0.1);  color:var(--gold);      }
.act-resolve  { background:rgba(80,150,110,0.1);  color:var(--green-dot); }
.act-delete   { background:rgba(192,96,80,0.1);   color:var(--red-dot);   }

/* ===== الرسائل ===== */
.messages-grid {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 16px;
}

.msg-list {
  background: var(--bg-dark);
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  height: fit-content;
}

.msg-item {
  display: flex;
  gap: 12px;
  padding: 14px 18px;
  border-bottom: 1px solid var(--border-soft);
  cursor: pointer;
  transition: background 0.2s;
  text-decoration: none;
  color: inherit;
  align-items: center;
}
.msg-item:last-child { border-bottom: none; }
.msg-item:hover { background: rgba(196,158,80,0.04); }
.msg-item.unread { background: rgba(196,158,80,0.06); }

.msg-avatar {
  width: 40px; height: 40px;
  background: rgba(196,158,80,0.1);
  border: 1px solid var(--border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: var(--gold);
  flex-shrink: 0;
}

.msg-name  { font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 2px; }
.msg-prev  { font-size: 11px; color: var(--text-muted); }
.msg-time  { font-size: 10px; color: var(--text-faint); margin-right: auto; flex-shrink: 0; }

.unread-dot {
  width: 8px; height: 8px;
  background: var(--gold);
  border-radius: 50%;
  flex-shrink: 0;
}

.chat-box {
  background: var(--bg-dark);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 20px;
  display: flex;
  flex-direction: column;
}

.chat-header {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-main);
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border-soft);
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.chat-header span {
  font-size: 12px;
  font-weight: 300;
  color: var(--text-muted);
}

.chat-messages {
  flex: 1;
  min-height: 280px;
  max-height: 380px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 16px;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

.bubble {
  max-width: 68%;
  padding: 10px 14px;
  border-radius: 12px;
  font-size: 13px;
  line-height: 1.55;
}

.bubble.me {
  background: var(--gold);
  color: var(--bg-dark);
  align-self: flex-end;
  border-bottom-right-radius: 3px;
  font-weight: 500;
}

.bubble.other {
  background: rgba(255,255,255,0.05);
  color: var(--text-main);
  align-self: flex-start;
  border: 1px solid var(--border-soft);
  border-bottom-left-radius: 3px;
}

.bubble-time {
  font-size: 10px;
  opacity: 0.55;
  margin-top: 4px;
  display: block;
}

.chat-input {
  display: flex;
  gap: 10px;
}

.chat-input input {
  flex: 1;
  background: var(--bg-card);
  border: 1px solid var(--border);
  color: var(--text-main);
  padding: 11px 16px;
  font-family: 'Cairo', sans-serif;
  font-size: 13px;
  border-radius: var(--radius);
  outline: none;
  transition: border-color 0.2s;
}
.chat-input input:focus { border-color: rgba(196,158,80,0.45); }
.chat-input input::placeholder { color: var(--text-faint); }

.chat-send {
  background: var(--gold);
  color: var(--bg-dark);
  border: none;
  padding: 11px 20px;
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 16px;
  transition: opacity 0.2s;
}
.chat-send:hover { opacity: 0.85; }

/* ===== FOOTER ===== */
.footer {
  background: var(--bg-dark);
  border-top: 1px solid var(--border);
  padding: 24px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 40px;
}

.footer-logo {
  font-family: 'Aref Ruqaa Ink', serif;
  font-size: 20px;
  font-weight: 700;
  color: rgba(196,158,80,0.38);
}

.footer-copy {
  font-size: 11px;
  font-weight: 300;
  color: var(--text-faint);
  letter-spacing: 0.1em;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 900px) {
  .navbar { padding: 0 20px; }
  .nav-links { display: none; }
  .hero { padding: 48px 20px 40px; }
  .hero-title { font-size: 40px; }
  .hero-title .sub { font-size: 24px; }
  .hero-stats { flex-wrap: wrap; gap: 20px; }
  .stat { padding: 0 24px; border-left: none; }
  .search-bar { padding: 16px 20px; flex-wrap: wrap; }
  .search-bar input { min-width: 100%; border-right: 1px solid var(--border) !important; }
  .main-content { padding: 24px 20px; }
  .dashboard-grid { grid-template-columns: 1fr; }
  .messages-grid { grid-template-columns: 1fr; }
  .stat-cards { grid-template-columns: 1fr 1fr; }
  .form-row { grid-template-columns: 1fr; }
  .footer { flex-direction: column; gap: 10px; text-align: center; padding: 20px; }
}
